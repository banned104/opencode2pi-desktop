{
  "schemaVersion": 1,
  "id": "com.opencode2pi",
  "name": "OpenCode免费模型",
  "version": "0.5.0",
  "description": "OpenCode Zen 匿名免费模型接入 PI-Desktop 模型选择器：manifest 声明 provider（provider.register），后台服务在 127.0.0.1 起回环端点（background.service），以 opencode2dsh 的伪装请求头与免费通道门禁转发到 https://opencode.ai/zen。聊天通道走 chat_completions，Muse Spark 系列走 OpenAI Responses 通道。上游默认自动走本机代理（插件设置 -> 环境变量 -> Windows 系统代理 -> 常见本地端口 -> 直连），因此无需 API 密钥，也无需 TUN 或改系统 DNS 即可在中国大陆使用。",
  "main": "main.js",
  "permissions": [
    "provider.register",
    "background.service"
  ],
  "engines": {
    "piDesktop": ">=0.9.0"
  },
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "services": [
      {
        "id": "zen-proxy",
        "label": "OpenCode Zen provider endpoint"
      }
    ],
    "settings": [
      {
        "key": "proxyUrl",
        "title": "上游代理",
        "type": "string",
        "default": "",
        "description": "auto（留空）：自动探测（环境变量 -> Windows 系统代理 -> 常见本地端口 7890/7897/1080/10809/9567 …）；off：直连；也可直接填代理地址，如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080。只影响本插件的上游请求。"
      }
    ],
    "commands": [
      {
        "id": "opencode.refresh",
        "title": "OpenCode免费模型: 刷新模型目录",
        "category": "AI",
        "keywords": [
          "opencode",
          "zen",
          "刷新模型",
          "refresh"
        ]
      },
      {
        "id": "opencode.status",
        "title": "OpenCode免费模型: 显示状态",
        "category": "AI",
        "keywords": [
          "opencode",
          "zen",
          "状态",
          "诊断",
          "status"
        ]
      }
    ],
    "providers": [
      {
        "id": "opencode-free",
        "name": "OpenCode免费模型",
        "vendorKey": "opencode",
        "baseUrl": "http://127.0.0.1:41860/v1",
        "apiStyle": "chat_completions",
        "authKind": "none",
        "models": [
          {
            "id": "big-pickle",
